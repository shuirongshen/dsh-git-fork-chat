{
  "name": "dsh-gitchat",
  "version": "0.1.0",
  "description": "GitChat - a Git-like conversation tree for DeepSeek Harness: visual session forks, branch management, and JSON export.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "conversation-tree",
    "git-like",
    "react-flow",
    "ai-agents"
  ],
  "type": "module",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "shuirong shen",
  "repository": {
    "type": "git",
    "url": "https://github.com/shuirongshen/dsh-git-fork-chat.git"
  },
  "homepage": "https://github.com/shuirongshen/dsh-git-fork-chat#readme",
  "bugs": {
    "url": "https://github.com/shuirongshen/dsh-git-fork-chat/issues"
  },
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "GITHUB_GUIDE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@types/dagre": "^0.7.52",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "@xyflow/react": "^12.8.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit"
  }
}
